[Desktop Entry]
# Template. Absolute paths are substituted by packaging/linux/install-desktop-entry.sh
# -- desktop entries cannot use relative paths, and the repo cannot know where it
# was checked out.
Type=Application
Name=ScreenMagnet
GenericName=Screen Caster
Comment=Cast this machine's screen to a TV
Exec=@EXEC@
Path=@WORKDIR@
Icon=screenmagnet
Terminal=false
Categories=AudioVideo;
Keywords=cast;mirror;airplay;screen;tv;
StartupWMClass=screenmagnet
X-GNOME-UsesNotifications=true
