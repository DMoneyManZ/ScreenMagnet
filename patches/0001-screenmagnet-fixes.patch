diff --git a/internal/airplay/capture_unix.go b/internal/airplay/capture_unix.go
new file mode 100644
index 0000000..683b4c3
--- /dev/null
+++ b/internal/airplay/capture_unix.go
@@ -0,0 +1,31 @@
+//go:build !windows
+
+package airplay
+
+import (
+	"context"
+	"fmt"
+	"os"
+)
+
+// gstBinary is the gst-launch-1.0 executable name to invoke. No .exe suffix
+// on Unix -- see gstBinaryInspect in capture.go.
+const gstBinary = "gst-launch-1.0"
+
+// startPlatformCapture detects the display server (Wayland or X11) and
+// initiates screen capture accordingly. On Wayland it uses xdg-desktop-portal
+// + PipeWire; on X11 it uses ximagesrc. This is the pre-Windows-support
+// dispatch logic, unchanged, moved into its own file so a Windows build can
+// supply its own startPlatformCapture/gstBinary instead. See capture.go.
+func startPlatformCapture(ctx context.Context, cfg CaptureConfig) (*ScreenCapture, error) {
+	if (cfg.X11WindowID != 0 || cfg.X11WindowName != "") && os.Getenv("DISPLAY") != "" {
+		return startX11Capture(ctx, cfg)
+	}
+	if os.Getenv("WAYLAND_DISPLAY") != "" {
+		return startWaylandCapture(ctx, cfg)
+	}
+	if os.Getenv("DISPLAY") != "" {
+		return startX11Capture(ctx, cfg)
+	}
+	return nil, fmt.Errorf("no display server detected (neither WAYLAND_DISPLAY nor DISPLAY is set)")
+}
