@@ -22,8 +22,36 @@ const conservativePlayoutLatency = 500 * time.Millisecond
 
 var targetLatencyNS atomic.Int64
 
+// playoutFloorOverrideNS, when >= 0, replaces the per-receiver playout floor.
+// Measured on an LG 43UK6090PUA (2026-08-01): the receiver honours our
+// presentation timestamps ~1:1, so this floor is ~500ms of the ~1.4s observed
+// end-to-end latency. Overriding it to 0 trades audio safety margin for
+// responsiveness -- appropriate when mirroring a desktop, not when the audio
+// matters. -1 means "use the receiver-derived default".
+var playoutFloorOverrideNS atomic.Int64
+
 func init() {
 	targetLatencyNS.Store(int64(defaultTargetLatency))
+	playoutFloorOverrideNS.Store(-1)
+}
+
+// SetPlayoutFloorOverride forces the receiver playout floor. Pass a negative
+// duration to restore the per-receiver default.
+func SetPlayoutFloorOverride(d time.Duration) {
+	if d < 0 {
+		playoutFloorOverrideNS.Store(-1)
+		return
+	}
+	playoutFloorOverrideNS.Store(int64(d))
+}
+
+// playoutFloorOverride returns the override and whether one is set.
+func playoutFloorOverride() (time.Duration, bool) {
+	v := playoutFloorOverrideNS.Load()
+	if v < 0 {
+		return 0, false
+	}
+	return time.Duration(v), true
 }
 
