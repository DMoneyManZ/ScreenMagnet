 // Returns (startX, startY, endX, endY) bounding the primary monitor, where
 // endX = startX + monitor_width and endY = startY + monitor_height. If
 // detection fails it returns all zeros, meaning no cropping should be applied.
+// detectNamedMonitor returns the geometry of a specific xrandr output (e.g.
+// "eDP", "DisplayPort-1"). Returns zeros if the output is not found or not
+// connected, in which case the caller should fall back to the primary monitor.
+func detectNamedMonitor(display, name string) (startX, startY, endX, endY int) {
+	out, err := exec.Command("xrandr", "--display", display, "--query").Output()
+	if err != nil {
+		dbg("[CAPTURE] xrandr failed: %v, cannot select monitor %q", err, name)
+		return 0, 0, 0, 0
+	}
+	for _, line := range strings.Split(string(out), "\n") {
+		if !strings.HasPrefix(line, name+" ") || !strings.Contains(line, " connected") {
+			continue
+		}
+		if x, y, w, h, ok := parseXrandrGeometry(line); ok {
+			return x, y, x + w, y + h
+		}
+	}
+	dbg("[CAPTURE] monitor %q not found among connected outputs", name)
+	return 0, 0, 0, 0
+}
